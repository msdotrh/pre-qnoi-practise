#include <bits/stdc++.h>
// #include <@msr.h>
using namespace std;
template <typename T> using vec = vector<T>;
using ll = long long;
namespace r = ranges;
char el = '\n';
#define int ll

vec<int> a;
vec<int> b;

const int MAXN = 1e18;

int dp(int i, int j, int x) {
  if (i < 0 || j < 0) {
    return -MAXN;
  }
  if (x == 0) {
    return 0;
  }
  int mn = min({dp(i - 1, j, x), dp(i, j - 1, x),
                dp(i - 1, j - 1, x - 1) + a[i] * b[j]});
  return mn;
}

signed main() {
  ios_base::sync_with_stdio(false);
  cin.tie(nullptr);
  cout.tie(nullptr);
  int n, k;
  cin >> n >> k;
  a.assign(n, 0);
  b.assign(n, 0);
  for (int &x : a) {
    cin >> x;
  }
  for (int &x : b) {
    cin >> x;
  }
  cout << dp(n - 1, n - 1, k) << el;
  ;
}
